{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-palace.local/schemas/mnemonic-story-output-v2.json",
  "title": "Mnemonic Story Output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frameworkVersion",
    "profile",
    "fullStory",
    "items"
  ],
  "properties": {
    "frameworkVersion": {
      "const": "MSF-2.0"
    },
    "profile": {
      "enum": [
        "collaborative_rescue",
        "hands_on_repair",
        "gentle_mystery"
      ]
    },
    "fullStory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "meaning",
          "storyOrder",
          "storySegment"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "storyOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "storySegment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
